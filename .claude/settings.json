{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_guard.py\" pre",
            "timeout": 120,
            "statusMessage": "TDD: 짝 테스트 근거 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_guard.py\" post",
            "timeout": 120,
            "statusMessage": "TDD: 관련 테스트 실행 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_guard.py\" stop",
            "timeout": 300,
            "statusMessage": "TDD: 전체 테스트 확인 중"
          }
        ]
      }
    ]
  }
}
